<Window x:Class="TicTacToe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToe"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
    <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF7ACACC" Offset="1"/>
                <GradientStop Color="#FF5FE5FF" Offset="0.08"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="130"/>
        </Grid.ColumnDefinitions>

        
        <Label Content="_X Player:"  Grid.Row="0" Margin="10,10,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="playerXBox" Grid.Row="0" Grid.Column="1" Margin="5,10,5,0" Text="Clint" VerticalAlignment="Center" TabIndex="1" ToolTip="Enter name for Player X"/>

        <Label Content="_O Player:" Grid.Row="1" Margin="10,5,0,10" VerticalAlignment="Center"/>
        <TextBox x:Name="playerOBox" Grid.Row="1" Grid.Column="1" Margin="5,5,5,10" Text="Kyle" VerticalAlignment="Center" TabIndex="2" ToolTip="Enter name for Player O"/>

        <Button x:Name="restartButton" Content="_Reset" Grid.Row="5" Grid.Column="2" Margin="5,10" Height="25" TabIndex="12" ToolTip="Click to Reset" AutomationProperties.AccessKey="R"/>
        <Button x:Name="exitButton" Content="E_xit" Grid.Row="5" Grid.Column="3" Margin="5,10" Height="25" TabIndex="13" ToolTip="Click to Exit" AutomationProperties.AccessKey="X" IsCancel="True"/>

        <Button x:Name="buttonTopLeft" Content="O" Margin="5" Grid.Row="2" FontSize="36" FontWeight="Bold" TabIndex="3" ToolTip="Top Left Square"/>
        <Button x:Name="buttonTopCenter" Grid.Column="1" Content="" Margin="5" Grid.Row="2" FontSize="36" FontWeight="Bold" TabIndex="4" ToolTip="Top Center Square"/>
        <Button x:Name="buttonTopRight" Grid.Column="2" Content="O" Margin="5" Grid.Row="2" FontSize="36" FontWeight="Bold" TabIndex="5" ToolTip="Top Right Square"/>

        <Button x:Name="buttonMiddleLeft" Content="X" Margin="5" Grid.Row="3" FontSize="36" FontWeight="Bold" TabIndex="6" ToolTip="Middle Left Square"/>
        <Button x:Name="buttonMiddleCenter" Grid.Column="1" Content="X" Margin="5" Grid.Row="3" FontSize="36" FontWeight="Bold" TabIndex="7" ToolTip="Middle Center Square"/>
        <Button x:Name="buttonMiddleRight" Grid.Column="2" Content="X" Margin="5" Grid.Row="3" FontSize="36" FontWeight="Bold" TabIndex="8" ToolTip="Middle Right Square"/>

        <Button x:Name="buttonBottomLeft" Content="" Margin="5" Grid.Row="4" FontSize="36" FontWeight="Bold" TabIndex="9" ToolTip="Bottom Left Square"/>
        <Button x:Name="buttonBottomCenter" Grid.Column="1" Content="" Margin="5" Grid.Row="4" FontSize="36" FontWeight="Bold" TabIndex="10" ToolTip="Bottom Center Square"/>
        <Button x:Name="buttonBottomRight" Grid.Column="2" Content="O" Margin="5" Grid.Row="4" FontSize="36" FontWeight="Bold" TabIndex="11" ToolTip="Bottom Right Square"/>

        <StackPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="3" Margin="10,5">

            <Label x:Name="currentTurnLabel" Content="Current Turn" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Label x:Name="currentPlayerLabel" Content="X" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>

            <Label x:Name="scoreLabel" Content="Score" FontWeight="Bold" HorizontalAlignment="Center"/>

            <Grid Margin="0,5,0,2">
                <Label Content="X" HorizontalAlignment="Left"/>
                <Label x:Name="scoreXLabel" Content="1" HorizontalAlignment="Right" FontWeight="Bold"/>
            </Grid>

            <Grid Margin="0,2">
                <Label Content="O" HorizontalAlignment="Left"/>
                <Label x:Name="scoreOLabel" Content="0" HorizontalAlignment="Right" FontWeight="Bold"/>
            </Grid>

            <Grid Margin="0,2"/>
        </StackPanel>
    </Grid>
</Window>
